import tkinter as tk
from tkinter import ttk, messagebox
from openpyxl import Workbook, load_workbook
from pathlib import Path

# ==============================
# FACULTY MANAGEMENT SYSTEM
# ==============================

FILE = Path("faculty_data.xlsx")

COLUMNS = [
    "Faculty ID",
    "Faculty Name",
    "Department",
    "Subject",
    "Qualification",
    "Contact",
    "Email",
    "Joining Date"
]


# ==============================
# EXCEL FUNCTIONS
# ==============================

def create_excel():
    if not FILE.exists():
        wb = Workbook()
        ws = wb.active
        ws.title = "Faculty"
        ws.append(COLUMNS)
        wb.save(FILE)


def get_records():
    create_excel()

    wb = load_workbook(FILE)
    ws = wb["Faculty"]

    records = []

    for row in ws.iter_rows(min_row=2, values_only=True):
        if any(value is not None for value in row):
            records.append(list(row))

    wb.close()

    return records


def add_record(data):
    create_excel()

    wb = load_workbook(FILE)
    ws = wb["Faculty"]

    ws.append(data)

    wb.save(FILE)
    wb.close()


def update_record(old_id, data):
    create_excel()

    wb = load_workbook(FILE)
    ws = wb["Faculty"]

    for row in range(2, ws.max_row + 1):

        if str(ws.cell(row, 1).value) == str(old_id):

            for col in range(1, 9):
                ws.cell(row, col).value = data[col - 1]

            wb.save(FILE)
            wb.close()

            return True

    wb.close()
    return False


def delete_record(faculty_id):
    create_excel()

    wb = load_workbook(FILE)
    ws = wb["Faculty"]

    for row in range(2, ws.max_row + 1):

        if str(ws.cell(row, 1).value) == str(faculty_id):

            ws.delete_rows(row, 1)

            wb.save(FILE)
            wb.close()

            return True

    wb.close()
    return False


